# LLM backend (defaults to local Ollama if unset).
# Point these at a bigger or cloud model to test — nothing else changes.
OPENAI_API_KEY=ollama
OPENAI_API_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=gemma3:4b

# Ask [y/N] before running each command. Off by default — full shell access is
# the point. Terminal REPL only; it never applies to an HTTP request.
# APRIL_CONFIRM=1

# Backend JSON API (main.py --serve). Binds the LAN so other users can reach it;
# the shell tool is network_ok=False, which is what makes 0.0.0.0 safe (remote
# callers get esp/read tools only, and /exec is refused off-box).
# HARNESS_HOST=0.0.0.0
# HARNESS_PORT=8787
# AGENT_MAX_STEPS=8

# AXIOM ESP tool (tools.py). ESP_BASE_URL is the `default` board; hardcode more
# boards as named entries in ESP_ENDPOINTS at the top of tools.py.
# ESP_BASE_URL=http://esp32-telemetry.local
# ESP_TIMEOUT=5
