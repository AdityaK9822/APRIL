# LLM backend (defaults to local Ollama if unset).
# gemma3:4b serves BOTH jobs: command translation and image reasoning.
OPENAI_API_KEY=ollama
OPENAI_API_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=gemma3:4b

# Ask [y/N] before running each command. Off by default — full shell access is the point.
# OPEN_INT_CONFIRM=1

# UI mode
# GUI=1

# Voice mode (VOICE=1) — needs `pip install -r requirements.txt`
# VOICE=1
# Free key from https://console.picovoice.ai  (required when VOICE=1)
# PICOVOICE_ACCESS_KEY=
# WAKE_WORD=computer
# WHISPER_MODEL=mlx-community/whisper-base.en-mlx
# PIPER_VOICE=en_US-lessac-medium

# Vision mode (VISION=1) — camera gestures + object detection
# VISION=1
# CAMERA_INDEX=0
# VISION_FPS=8
# VISION_WIDTH=640
# VISION_OBJECT_EVERY=12
# VISION_DEVICE=mps
# YOLO_WEIGHTS=yolo11n.pt
