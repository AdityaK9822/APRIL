# APRIL Configuration

# OpenAI-compatible API Configuration
OPENAI_API_KEY=your_api_key_here
OPENAI_API_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=mistral

# Optional: Override model settings
# MAX_CONTEXT_LENGTH=128000
# TEMPERATURE=0.7
# MAX_ITERATIONS=100


# ----------------------------------------------------------------------------
# Harness² (recursive agent harnessing) — see docs/implementation/MASTER-IMPLEMENTATION-ROADMAP.md
# ----------------------------------------------------------------------------

# Model identifiers (OpenAI-compatible "provider:model" form). Leave blank to
# fall back to the APRIL agent's models.
APRIL_SOLVER_MODEL=your_solver_model_here
# Defaults to APRIL_SOLVER_MODEL when unset.
APRIL_IMPROVER_MODEL=
APRIL_JUDGE_MODEL=your_judge_model_here

# Where run artifacts (contexts, ledgers, harnesses) are written.
APRIL_RUNS_DIR=./runs

# Sandbox limits for rollout execution.
APRIL_SANDBOX_TIMEOUT=30
APRIL_SANDBOX_MAX_OUTPUT=50000

# Number of candidate harnesses per recursive phase.
APRIL_PHASE_WIDTH=2
